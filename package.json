{
  "name": "unspool",
  "version": "1.0.0",
  "description": "Unspool — a static, in-browser JavaScript deobfuscator. Unwinds JS-Confuser, javascript-obfuscator, JSDefender, packer, jsfuck, jjencode/aaencode and more, entirely client-side.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@babel/generator": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.24.2",
    "fflate": "^0.8.2"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2"
  }
}
